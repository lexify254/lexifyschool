# Supabase — use the new `lexify school` project
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me_server_only

# Public production origin (omit until configured; never use an internal Preview host)
NEXT_PUBLIC_SITE_URL=https://example.com

# Payments — test mode until live credentials are deliberately configured
PAYMENT_PROVIDER=paystack
PAYMENT_ALLOW_PAYER_CHOICE=true
PAYMENT_TEST_MODE=true
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_CALLBACK_URL=https://example.com/payments/return
PESAPAL_ENVIRONMENT=sandbox
PESAPAL_CONSUMER_KEY=replace_me
PESAPAL_CONSUMER_SECRET=replace_me
PESAPAL_IPN_ID=replace_me
PESAPAL_CALLBACK_URL=https://example.com/payments/return

# Notifications (optional provider adapter)
EMAIL_PROVIDER=none
RESEND_API_KEY=replace_me
EMAIL_FROM=Lexify School <no-reply@example.com>
SMS_PROVIDER=none
SMS_API_KEY=replace_me

# Upload security: production uploads should fail closed if scanning is not configured
MALWARE_SCAN_PROVIDER=none
MALWARE_SCAN_API_URL=https://scanner.example.com
MALWARE_SCAN_API_KEY=replace_me
MAX_UPLOAD_MB=50

# Business details used by PDFs and receipts — fill with verified details only
BUSINESS_NAME=Lexify School
BUSINESS_TOWN=
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_WEBSITE=https://example.com
ADMIN_SETUP_EMAIL=
PDF_VERIFICATION_BASE_URL=https://example.com/verify
WHATSAPP_ADMIN_NUMBER=

# Operational settings
PAYMENT_WEBHOOK_SECRET=replace_me
RATE_LIMIT_SECRET=replace_me
LOG_LEVEL=info

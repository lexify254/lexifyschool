# Supabase — use the new `lexify school` project
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me_server_only

# Public production origin (omit until configured; never use an internal Preview host)
NEXT_PUBLIC_SITE_URL=https://lexifyschool.vercel.app

# Notifications (optional provider adapter)
EMAIL_PROVIDER=none
RESEND_API_KEY=replace_me
EMAIL_FROM=Lexify School <no-reply@example.com>
SMS_PROVIDER=none
SMS_API_KEY=replace_me

# Upload limit. Runtime defaults to 100 MiB and accepts configured values from 1 to 100.
# Uploads are type/signature checked and stored privately; malware scanning is not enabled.
MAX_UPLOAD_MB=100

# Business contact details — fill with verified details only
BUSINESS_NAME=Lexify School
BUSINESS_TOWN=
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_WEBSITE=https://example.com
ADMIN_SETUP_EMAIL=
WHATSAPP_ADMIN_NUMBER=

# Operational settings
RATE_LIMIT_SECRET=replace_me
LOG_LEVEL=info
